#ifndef _INCLUDE_SYMBOLS_DTSH
#define _INCLUDE_SYMBOLS_DTSH

/* Memory attribute secure/non-secure symbols */
#define SECURE 1
#define NON_SECURE 0

/* Memory region 'ram' property value */
#define QEMU_RAM_PROPERTY_NOT_RAM 0
#define QEMU_RAM_PROPERTY_INTERNAL 1 /* internally allocated by QEMU */
#define QEMU_RAM_PROPERTY_FILE 2 /* mapped to a file */

/* EndianMode QAPI definition */
#define QEMU_ENDIAN_MODE_UNSPECIFIED "unspecified"
#define QEMU_ENDIAN_MODE_LITTLE "little"
#define QEMU_ENDIAN_MODE_BIG "big"

#endif
