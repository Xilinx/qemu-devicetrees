#include "board-versal-xcvr1602-ps-virt.dts"

/ {
	/* Board has 16GByte of DDR5 */
	MEM_REGION(ddr, 0x0, MM_TOP_DDR_2_L, 0x00000000, 0x80000000, &ddr_mem) // 2GB
	MEM_REGION64_DDR(ddr2, MM_TOP_DDR_2_H, MM_TOP_DDR_2_L, MM_TOP_DDR_2,
			0x00000000,  0x80000000, &ddr_2_mem) // 2GB
	MEM_REGION64_DDR(c1_ddr, MM_TOP_DDR_CH1_H, MM_TOP_DDR_CH1_L, MM_TOP_DDR_CH1,
			0x00000001,  0x00000000, &ddr_3_mem) // 4GB
	MEM_REGION64_DDR(c2_ddr, MM_TOP_DDR_CH2_H, MM_TOP_DDR_CH2_L, MM_TOP_DDR_CH2,
			0x00000001,  0x00000000, &ddr_3_mem) // 4GB
	MEM_REGION64_DDR(c3_ddr, MM_TOP_DDR_CH3_H, MM_TOP_DDR_CH3_L, MM_TOP_DDR_CH3,
			0x00000001,  0x00000000, &ddr_3_mem) // 4GB

};

/* No SPI nor QSPI have any memories mapped.  */
&spi0 {
	/delete-node/ spi0_flash0@0;
};

&spi1 {
	/delete-node/ spi1_flash0@0;
};

&pmc_qspi_0 {
	/delete-node/ qspi_flash_lcs_lb@0;
	/delete-node/ qspi_flash_lcs_ub@0;
	/delete-node/ qspi_flash_ucs_lb@0;
	/delete-node/ qspi_flash_ucs_ub@0;
};

/* Attach only one OSPI Flash */
&ospi {
	/delete-node/ ospi_flash_lcs_ub@0;
	/delete-node/ ospi_flash_ucs_lb@0;
	/delete-node/ ospi_flash_ucs_ub@0;
};

&ospi_flash_lcs_lb {
	compatible = "mt35xu02gbba";
};

&mdio0 {
	/delete-node/ phy@2;

};

&gem0 {
	mdio = <&mdio0>;
};

&ps_i2c1 {
	i2c-arbitrator@72 {
		#address-cells = <1>;
		#size-cells = <0>;
		compatible = "nxp,pca9541";
		reg = <0x72>;
		i2c@0 {
			#address-cells = <1>;
			#size-cells = <0>;
			reg = <0>;
			eeprom@54 {
				compatible = "m24cxx";
				size = <0x4000>;
				reg = <0x54>;
				blockdev-node-name = "ps_i2c1.eeprom-54";
			};
		};
	};
};
